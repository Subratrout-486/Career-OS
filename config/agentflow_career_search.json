{
  "id": "career-search",
  "name": "Career OS — Automated Job Search",
  "schedule": "0 */4 * * *",
  "timezone": "Asia/Kolkata",
  "schedule_policy": {
    "description": "Run every 4 hours by default; replace schedule with any valid cron expression for a different frequency.",
    "default_runs_per_day": 6,
    "min_interval_minutes": 30,
    "overlap_policy": "skip",
    "catchup_window_minutes": 120
  },
  "max_concurrency": 1,
  "nodes": [
    {"id":"discover","kind":"job_discovery","retry_limit":2},
    {"id":"dedupe","kind":"deduplicate","depends_on":["discover"],"input_from":["discover"],"retry_limit":1},
    {"id":"jd","kind":"jd_enrichment","depends_on":["dedupe"],"input_from":["dedupe"],"retry_limit":2},
    {"id":"fit","kind":"career_fit","agent_id":"career-fit","depends_on":["jd"],"input_from":["jd"],"retry_limit":2},
    {"id":"resume","kind":"resume_builder","agent_id":"resume-builder","depends_on":["fit"],"input_from":["fit"],"retry_limit":2},
    {"id":"truth","kind":"truth_guard","agent_id":"truth-guard","depends_on":["resume"],"input_from":["resume"],"retry_limit":1},
    {"id":"ats","kind":"ats_review","agent_id":"ats-scorer","depends_on":["truth"],"input_from":["truth"],"retry_limit":1},
    {"id":"review","kind":"independent_review","agent_id":"challenger","depends_on":["ats"],"input_from":["ats"],"retry_limit":1},
    {"id":"approval","kind":"application_approval","depends_on":["review"],"input_from":["review"],"requires_approval":true},
    {"id":"apply","kind":"browser_application","depends_on":["approval"],"input_from":["approval"],"retry_limit":1}
  ]
}
