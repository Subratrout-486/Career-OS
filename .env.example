# Career OS environment template
# Copy to .env and fill real values. Never commit secrets.

AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional alternate providers
GITHUB_TOKEN=
GITHUB_MODEL=openai/gpt-4.1
# Independent challenger requires a key with chat + model ACLs in console.x.ai
XAI_API_KEY=
GROK_MODEL=grok-4.6
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
XAI_MODEL=grok-4.6

# Notion — Human Review Queue + Resume Library
NOTION_TOKEN=
NOTION_REVIEW_QUEUE_PAGE_ID=
NOTION_RESUME_LIBRARY_DATA_SOURCE_ID=3ac8bc1d-ce0e-8051-a553-000bb5f58abe
NOTION_APPLICATIONS_DATA_SOURCE_ID=a6925702-0d2a-4d68-919b-3401e1d8ff75
NOTION_EVIDENCE_VAULT_DATA_SOURCE_ID=eb8a5be7-990e-47d3-9b36-c922ff0bb3aa
NOTION_VERSION=2026-03-11

# Gmail job-alert intake (OAuth refresh-token flow; readonly mailbox access)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_QUERY=newer_than:7d (job OR jobs OR career OR opportunity OR hiring OR support)
