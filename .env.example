# Career OS environment template
# Never put paid AI-provider API keys in this project.
# AI work is delegated to Conductor/AgentFlow; GitHub Actions is the scheduler/queue.

# Notion — Human Review Queue + Resume Library
NOTION_TOKEN=
NOTION_REVIEW_QUEUE_PAGE_ID=
NOTION_RESUME_LIBRARY_DATA_SOURCE_ID=3ac8bc1d-ce0e-8051-a553-000bb5f58abe
NOTION_APPLICATIONS_DATA_SOURCE_ID=a6925702-0d2a-4d68-919b-3401e1d8ff75
NOTION_EVIDENCE_VAULT_DATA_SOURCE_ID=eb8a5be7-990e-47d3-9b36-c922ff0bb3aa
NOTION_VERSION=2026-03-11

# Gmail job-alert intake (OAuth refresh-token flow; readonly mailbox access)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_QUERY=newer_than:7d (job OR jobs OR career OR opportunity OR hiring OR support)

# Conductor / AgentFlow is the AI orchestration boundary.
# Do not add xAI/Gemini/DeepSeek/OpenAI API keys here.
# The GitHub issue created by Stage 1 is the durable task handoff.
#
# Runtime bridge: provide the EXACT endpoint exposed by your connected
# Conductor/AgentFlow environment. Career OS intentionally does not guess
# provider-specific paths.
CONDUCTOR_DISPATCH_URL=
CAREER_OS_CONDUCTOR_RUNTIME_TOKEN=

# Browser execution is a separate authenticated boundary.
# Credentials should be managed by the connected browser/Conductor environment,
# not as model-provider API keys in Career OS.
MANUS_BROWSER_AGENT_PROFILE=manus-1.6

# Browser execution should be enabled only by a controlled scheduler or reviewer after AUTO_APPLY is issued.
CAREER_OS_EXECUTION_ENABLED=false
